# ===================================================
# Anonymous AUA Telegram Bot Configuration Template
# ===================================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated list of numeric Telegram IDs)
ADMIN_IDS=123456789

# PostgreSQL Database Credentials
POSTGRES_USER=aua_user
POSTGRES_PASSWORD=aua_secure_password_here
POSTGRES_DB=aua_chat_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Telegram API Credentials (from my.telegram.org for Local Bot API server)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Local Bot API Server URL (optional; unlocks 2 GB uploads and local file handling)
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Google Gemini API Key (for Automated Multimodal AI Moderation & AUA Hub AI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Assistant Global Budget & Token Guardrails (optional overrides)
AI_GLOBAL_HOURLY_PROMPT_LIMIT=120
AI_GLOBAL_DAILY_PROMPT_LIMIT=600
AI_MAX_CONCURRENT_GEMINI_CALLS=6
AI_PLANNER_MAX_OUTPUT_TOKENS=256
AI_SYNTHESIS_MAX_OUTPUT_TOKENS=1800
AI_PLANNER_THINKING_BUDGET=0
AI_SYNTHESIS_THINKING_BUDGET=256

# Media Guardrails & Anti-DDoS Protection
MAX_MEDIA_FILE_SIZE_MB=100

# Matchmaking & Anti-Cheat Cooldowns
REMATCH_COOLDOWN_MINUTES=20
SUGGESTION_COOLDOWN_MINUTES=5

# University Email Verification (SMTP)
# (Optional: If omitted, OTP verification runs in simulated/dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=verification@aua.am
SMTP_USE_TLS=true

# AUA Hub Companion Website & Room Booking Scraper Credentials
BOOKING_AUA_USER=your_booking_username
BOOKING_AUA_PASS=your_booking_password
WEB_JWT_SECRET=change_this_to_a_secure_random_jwt_secret
WEB_PORT=8000

# Google OAuth 2.0 Authentication (optional; configure for @edu.aua.am / @alumni.aua.am Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://auahub.am/api/auth/callback/google

# Cloudflare Dynamic DNS (DDNS) API Token 
CLOUDFLARE_API_TOKEN=

# Cloudflare Tunnel Token 
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Turnstile Anti-Bot Protection (optional; set real keys from Cloudflare dashboard to enforce)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
AUTH_EMAIL_COOLDOWN_SECONDS=180

# Jenzareviews Postgres DB URL
DATABASE_URL=
# Supabase Project REST/Realtime API URL
SUPABASE_URL=
# Supabase Publishable / Anon Key
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Supabase Secret / Service Role Key (Server-side only)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
