# ===================================================
# Anonymous AUA Telegram Bot Configuration Template
# ===================================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User IDs (comma-separated list of numeric Telegram IDs)
ADMIN_IDS=123456789

# PostgreSQL Database Credentials
POSTGRES_USER=aua_user
POSTGRES_PASSWORD=aua_secure_password_here
POSTGRES_DB=aua_chat_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Telegram API Credentials (from my.telegram.org for Local Bot API server)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Local Bot API Server URL (optional; unlocks 2 GB uploads and local file handling)
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Media Guardrails & Anti-DDoS Protection
MAX_MEDIA_FILE_SIZE_MB=100

# Matchmaking & Anti-Cheat Cooldowns
REMATCH_COOLDOWN_MINUTES=20
SUGGESTION_COOLDOWN_MINUTES=5

# University Email Verification (SMTP)
# (Optional: If omitted, OTP verification runs in simulated/dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=verification@aua.am
SMTP_USE_TLS=true

